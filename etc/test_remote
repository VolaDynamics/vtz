#!/usr/bin/env bash
#
# Build vtz on a remote machine and run something in the remote repo.
#
#   etc/test_remote <host> <dir> [--target=T[,T...]]... [--config=C] [-D...] \
#                   [-- <command>...]
#
# Syncs this working tree to ~/<dir>/<repo-name> on <host>, configures it the
# same way `just gen` does, builds the requested targets, then runs <command>
# with the remote repo as the working directory.
#
#   etc/test_remote monster .builds --target=bench_vtz -- \
#       build/bench_vtz --benchmark_filter='add_months|add_years' \
#                       --benchmark_min_warmup_time=0.1
#
# Notes:
#   - build/ is excluded from the sync, so the remote build tree survives
#     between runs and rebuilds are incremental.
#   - The remote directory is named after the checkout, so worktrees get their
#     own build rather than fighting over one.
#   - --delete is on: the remote tree mirrors this one, minus the excludes.
#   - The remote script arrives on stdin, so <command> cannot read stdin.

set -euo pipefail

die() { printf 'test_remote: %s\n' "$*" >&2; exit 1; }
# Quote arguments so the remote shell sees them exactly as given here. %q is
# bash's own quoter, which is why the remote side is run under bash: it emits
# $'...' for control characters.
quote() { local a; for a in "$@"; do printf '%q ' "$a"; done; }

[ $# -ge 2 ] || die "usage: test_remote <host> <dir> [--target=T]... [--config=C] [-- <command>...]"
host=$1 dir=$2
shift 2

targets=() cmake_args=() config=Release
while [ $# -gt 0 ]; do
    case $1 in
    --) shift; break ;;
    --target=*) IFS=, read -r -a add <<<"${1#*=}"; targets+=( "${add[@]}" ) ;;
    --config=*) config=${1#*=} ;;
    -D*) cmake_args+=( "$1" ) ;;
    *) die "unrecognised option '$1' - the command to run goes after '--'" ;;
    esac
    shift
done

root=$(git -C "$(dirname "$0")" rev-parse --show-toplevel) || die "not in a git checkout"
remote=$dir/$(basename "$root")

printf '\033[1;34m==>\033[0m syncing %s -> %s:~/%s\n' "$root" "$host" "$remote" >&2
ssh "$host" "mkdir -p ~/$(quote "$remote")"
rsync -a --delete \
    --exclude=/build/ --exclude=/install/ --exclude=/.cache/ --exclude=/.git/ \
    "$root/" "$host:$(quote "$remote")/"

# Everything below runs in one remote login shell, so a failure at any step
# stops the rest and $PATH picks up cmake/ninja from the user's profile.
targets_q="" cmake_q=""
[ ${#targets[@]} -gt 0 ] && targets_q=$(quote "${targets[@]}")
[ ${#cmake_args[@]} -gt 0 ] && cmake_q=$(quote "${cmake_args[@]}")

{
    cat <<'PRELUDE'
set -euo pipefail
step() { printf '\033[1;34m==>\033[0m %s\n' "$*" >&2; }
step "on $(hostname) ($(uname -s) $(uname -m))"
PRELUDE
    printf 'cd ~/%s\n' "$(quote "$remote")"
    printf 'step %s\n' "$(quote "configuring ($config)")"
    printf 'cmake -B build -G Ninja -DVTZ_BUILD_SHARED=ON -DCMAKE_BUILD_TYPE=%s -DCMAKE_INSTALL_PREFIX=install %s\n' \
        "$(quote "$config")" "$cmake_q"
    printf 'step %s\n' "$(quote "building ${targets[*]:-all}")"
    printf 'ninja -C build %s\n' "$targets_q"
    if [ $# -gt 0 ]; then
        printf 'step %s\n' "$(quote "running: $*")"
        printf '%s\n' "$(quote "$@")"
    fi
} | ssh "$host" bash -l -s
